{
  "name": "@haven/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "HAVEN Expo app (Android + web) — guest web screens (SDD §13), see docs/TRACEABILITY.md",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@haven/shared": "workspace:*",
    "@haven/ui": "workspace:*",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@haven/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.13",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.3"
  }
}
