# HAVEN web app — Phase 1 deployed test version (DEC-026, DEC-028; docs/DEPLOY-TEST.md).
# Typed into Vercel → Project → Settings → Environment Variables. Every EXPO_PUBLIC_*
# value is built into the public web app, so never put a server secret here.
#
# For the laptop demo you need none of this; the root .env.example has local values.

# Shows the "TEST VERSION · dummy data" badge and the test-number sign-in.
EXPO_PUBLIC_APP_ENV=staging
# The Vercel address itself: the API is reached through the /v1 rewrite in vercel.json.
EXPO_PUBLIC_API_URL=https://<your-app>.vercel.app
# The same address: gate QR codes and invite links point here.
EXPO_PUBLIC_WEB_URL=https://<your-app>.vercel.app
# Cloudflare Turnstile site key for the OTP CAPTCHA. Phase 1: Cloudflare's published
# always-pass test key (docs/DEPLOY-TEST.md).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
# Not used in Phase 1 (no Google sign-in, no Sentry, no dev sign-in): leave unset.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_DEV_LOGIN_ENABLED=false
