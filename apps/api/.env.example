# HAVEN API — Phase 1 deployed test version (DEC-026, DEC-028; docs/DEPLOY-TEST.md).
# Variable NAMES with safe placeholders only. Real values are typed into the Render
# dashboard (part A) or into apps/api/.env.staging.local on your own computer (part B).
# Never commit a real value. Generate secrets with: node scripts/generate-secrets.mjs
#
# For the laptop demo you need none of this (`pnpm demo` sets everything itself); the
# full local reference is the root .env.example.

# ===== A. Render → haven-test-api → Environment =====
# Set by render.yaml (no need to type them):
#   NODE_VERSION, NODE_ENV=production, APP_ENV=staging, WORKER_ENABLED=true,
#   SMS_PROVIDER=console, TRUST_PROXY_HOPS=2, LOG_LEVEL=info,
#   GOOGLE_CLIENT_IDS=unused-in-phase-1, DB_POOL_MAX=5

# Queries: Supabase transaction pooler, port 6543, user haven_api.<project-ref>.
DATABASE_URL=postgres://haven_api.<project-ref>:<HAVEN_API_DB_PASSWORD>@aws-<n>-ap-south-1.pooler.supabase.com:6543/postgres
# Live updates (LISTEN): the same pooler host in SESSION mode, port 5432.
DATABASE_DIRECT_URL=postgres://haven_api.<project-ref>:<HAVEN_API_DB_PASSWORD>@aws-<n>-ap-south-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API: the project URL (photo storage).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API: the service_role key. Server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# From scripts/generate-secrets.mjs (32 random bytes, base64 each).
JWT_SECRET=<generated>
OTP_PEPPER=<generated>
# Also goes in apps/api/.env.staging.local — the two must be identical.
DATA_ENCRYPTION_KEY=<generated>
# OTP CAPTCHA after 3 requests from one IP. Phase 1: Cloudflare's published always-pass
# test secret (docs/DEPLOY-TEST.md); a real one in Phase 2.
TURNSTILE_SECRET=<turnstile-secret>
# The Vercel address (the API is served under it through a rewrite). No trailing slash.
API_BASE_URL=https://<your-app>.vercel.app
WEB_BASE_URL=https://<your-app>.vercel.app
CORS_ORIGINS=https://<your-app>.vercel.app
# Leave unset in Phase 1: the refresh cookie is host-only on the Vercel address.
# COOKIE_DOMAIN=
# Optional: PEM of the database CA; unset = the pinned Supabase root (src/db/ssl.ts).
# DATABASE_CA_CERT=

# ===== B. apps/api/.env.staging.local (your computer only; gitignored) =====
# Read by `pnpm --filter @haven/api run staging -- migrate | seed | reset`.
# APP_ENV=staging
# Owner connection for migrations and the seed: SESSION pooler, port 5432, user postgres.<project-ref>.
# MIGRATION_DATABASE_URL=postgres://postgres.<project-ref>:<database-password>@aws-<n>-ap-south-1.pooler.supabase.com:5432/postgres
# The password the API logs in with as haven_api (same value as inside DATABASE_URL above).
# HAVEN_API_DB_PASSWORD=<generated>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# DATA_ENCRYPTION_KEY=<same as on Render>
# Optional gate position for the seed; leave out to set it from the phone (Gates screen).
# SEED_GATE_LAT=
# SEED_GATE_LNG=
# SEED_GATE_RADIUS_M=200
