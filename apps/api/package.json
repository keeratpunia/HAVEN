{
  "name": "@haven/api",
  "version": "0.0.0",
  "private": true,
  "description": "HAVEN Fastify API — bootstrap foundation only (no business routes yet, see docs/IMPLEMENTATION-PLAN.md M1+)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@haven/shared": "workspace:*",
    "fastify": "^5.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@haven/config": "workspace:*",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.12.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
