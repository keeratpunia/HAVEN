# Same line endings on every machine: Git for Windows defaults to core.autocrlf=true,
# which would check every file out with CRLF and make `pnpm format:check` (Prettier,
# endOfLine "lf") fail on a fresh clone.
* text=auto eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.y4m binary

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
