# HAVEN environment variables (SDD §20.3) — every variable, with SAFE LOCAL values.
#
# You do NOT need this file for the demo or the tests: `pnpm demo`, `pnpm demo:tunnel`,
# `pnpm test` and Playwright set everything they need themselves, with throwaway local
# values, against a local database they start. No real secret is needed anywhere.
#
# The API reads the process environment only (apps/api/src/config.ts validates it);
# nothing loads a .env file automatically. This file is the reference for a real
# deployment (staging/production), where every value marked LOCAL ONLY must be replaced
# by a freshly generated one, stored in the host's secret settings — never committed.
# Any real .env file is gitignored. The deployed Phase 1 test version's variables, one
# line each, are in apps/api/.env.example and apps/mobile/.env.example (DEC-028).

# ---- API: core (apps/api/.env) ----
APP_ENV=local                                   # [BOOTSTRAP] REQUIRED: local | staging | production (no default)
TRUST_PROXY_HOPS=0                              # proxies in front of the API (Render alone = 1; Vercel rewrite + Render = 2); 0 ignores X-Forwarded-For
PORT=8080                                        # [BOOTSTRAP]
LOG_LEVEL=info                                   # [BOOTSTRAP] fatal|error|warn|info|debug|trace|silent
API_BASE_URL=http://localhost:8080               # [BOOTSTRAP]
WEB_BASE_URL=http://localhost:8081               # [BOOTSTRAP]
CORS_ORIGINS=http://localhost:8081               # [BOOTSTRAP] comma list
COOKIE_DOMAIN=                                   # refresh-cookie domain (.<your domain>); empty = host-only cookie (Phase 1, DEC-028)

# ---- API: database (apps/api/.env) ----
# Local: the demo database (`pnpm --filter @haven/api run demo:db` starts it on 54625).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54625/haven_demo        # real: pooler URL, port 6543, user haven_api
DATABASE_DIRECT_URL=postgres://postgres:postgres@127.0.0.1:54625/haven_demo # real: session connection, port 5432 (SSE LISTEN, §9.9); the transaction pooler (6543) is refused outside local
DATABASE_CA_CERT=                                # optional PEM; empty = pinned Supabase root CA (apps/api/src/db/ssl.ts)
DB_POOL_MAX=10                                   # [BOOTSTRAP]

# ---- API: Supabase storage (SDD §9.10) — required outside local ----
SUPABASE_URL=                                    # https://<project>.supabase.co; unset in local = photos on disk under MEDIA_STORAGE_DIR
SUPABASE_SERVICE_ROLE_KEY=                       # storage only; never sent to clients
MEDIA_STORAGE_DIR=.media-storage                 # local only: where photos go when SUPABASE_URL is unset

# ---- API: auth and crypto secrets (M1+) ----
# LOCAL ONLY — the demo's fixed, deliberately patterned keys. Real environments:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=DQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0=         # [AUTH] 32+ random bytes, base64
OTP_PEPPER=ERERERERERERERERERERERERERERERERERERERERERE=         # [AUTH] 32 random bytes, base64
DATA_ENCRYPTION_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws= # exactly 32 bytes, base64 — encrypts gate secrets
GOOGLE_CLIENT_IDS=local-unused-client-id         # [AUTH] comma list (web, Android) — allowed `aud` values

# ---- API: SMS provider (M3) ----
SMS_PROVIDER=console                             # [AUTH] console | msg91 (msg91 not implemented — see DEC-007)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATES=                                 # JSON map of template IDs

# ---- API: push and security providers (M2+) ----
EXPO_ACCESS_TOKEN=
TURNSTILE_SECRET=                                # OTP CAPTCHA (SDD §16.1 T10)
SENTRY_DSN=

# ---- API: worker (M2+) ----
WORKER_ENABLED=true                              # exactly one running instance must have it on

# ---- API: seed script (local/staging only) ----
SEED_SUPER_ADMIN_EMAIL=
SEED_WARDEN_EMAIL=

# ---- API: dev-only resident/staff sign-in bypass (demo milestone, DEC-011) ----
# Never set outside local dev / the demo script — buildApp refuses to start with this
# true unless NODE_ENV=development, independent of this flag.
DEV_LOGIN_ENABLED=false

# ---- Demo only (read by scripts/, never by the API) ----
# Prefer demo.config.json (created on the first `pnpm demo`); these override it once.
# DEMO_GATE_LAT=12.9716
# DEMO_GATE_LNG=77.5946
# DEMO_GATE_RADIUS_M=150
# PROXY_PORT=9000

# ---- Mobile app (apps/mobile/.env, public by design — never put a server secret here) ----
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=http://localhost:8081
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_DEV_LOGIN_ENABLED=false         # mirrors the API's own DEV_LOGIN_ENABLED; demo script sets both
