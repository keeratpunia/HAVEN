{
  "name": "haven",
  "version": "0.0.0",
  "private": true,
  "description": "HAVEN — Hostel Access and Visitor Entry Network",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "demo": "node scripts/demo.mjs",
    "demo:tunnel": "node scripts/demo-tunnel.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:smoke": "pnpm --filter @haven/api run demo:smoke",
    "demo:clock": "pnpm --filter @haven/api run demo:clock --",
    "demo:job": "pnpm --filter @haven/api run demo:job --",
    "demo:pair-code": "pnpm --filter @haven/api run demo:pair-code",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
